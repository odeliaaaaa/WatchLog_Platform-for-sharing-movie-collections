@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "會員管理中心";
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-danger">最高權限會員管理中心</h2>
        <p class="text-muted"></p>
    </div>

    <div class="card shadow-lg border-0 rounded-4" style="background: rgba(255,255,255,0.8); backdrop-filter: blur(15px);">
        <div class="row mb-4 justify-content-end">
            <div class="col-md-6 col-lg-5">
                <form asp-action="Index" method="get" class="d-flex shadow-sm rounded-pill overflow-hidden bg-white" style="border: 1px solid #ced4da;">
                    <input type="text" name="searchEmail" value="@ViewBag.SearchEmail" class="form-control border-0 px-4" placeholder="輸入信箱關鍵字搜尋..." style="box-shadow: none; outline: none; background: transparent;">
                    <button type="submit" class="btn btn-outline-primary px-4 fw-bold border-0 text-nowrap flex-shrink-0" style="border-radius: 0;">
                        搜尋
                    </button>
                </form>
            </div>
        </div>

        <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold m-2">註冊會員名單</h5>
            <a asp-action="Create" class="btn btn-light btn-sm rounded-pill px-3 fw-bold text-dark shadow-sm">＋ 新增會員</a>
        </div>

        <div class="card-body p-0 pb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">會員信箱 (帳號)</th>
                            <th class="px-4 py-3">認證狀態</th>
                            <th class="px-4 py-3 text-end">管理操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 fw-bold text-primary">@user.Email</td>
                                <td class="px-4 py-3">
                                    <span class="badge bg-success rounded-pill px-3">已啟用</span>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info rounded-pill px-3 me-2">詳細</a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-2">編輯</a>

                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="delete-form mb-0 d-inline">
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 delete-btn">停權</button>
                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    目前還沒有符合條件的會員喔！
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4 mb-2">
                    <ul class="pagination justify-content-center mb-0">

                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link shadow-sm rounded-start-pill px-4 py-2" href="/Admin/Index?page=@(ViewBag.CurrentPage - 1)&searchEmail=@ViewBag.SearchEmail">
                                上一頁
                            </a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link shadow-sm px-4 py-2 @(i == ViewBag.CurrentPage ? "fw-bold" : "")" href="/Admin/Index?page=@i&searchEmail=@ViewBag.SearchEmail">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link shadow-sm rounded-end-pill px-4 py-2" href="/Admin/Index?page=@(ViewBag.CurrentPage + 1)&searchEmail=@ViewBag.SearchEmail">
                                下一頁
                            </a>
                        </li>

                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const form = this.closest('.delete-form');
                    Swal.fire({
                        title: '確定要刪除這位會員嗎？',
                        text: "刪除後該會員將無法登入，且資料無法恢復！",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d63031',
                        cancelButtonColor: '#636e72',
                        confirmButtonText: '確定刪除',
                        cancelButtonText: '取消',
                        customClass: { popup: 'rounded-4' }
                    }).then((result) => {
                        if (result.isConfirmed) form.submit();
                    })
                });
            });
        });
    </script>
}