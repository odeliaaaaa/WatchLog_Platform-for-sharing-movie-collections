@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "編輯會員";
}

<div class="container mt-5 mb-5" style="max-width: 600px;">
    <div class="card shadow-lg border-0 rounded-4 p-5" style="background: rgba(255,255,255,0.85); backdrop-filter: blur(15px);">
        <h3 class="fw-bold mb-4 text-center text-primary">✏編輯會員資料</h3>

        <form asp-action="Edit" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

            <div class="form-floating mb-3">
                <input type="email" name="email" class="form-control" value="@Model.Email" required />
                <label>電子郵件 (帳號)</label>
            </div>

            <div class="position-relative mb-4">
                <div class="form-floating">
                    <input type="password" name="newPassword" class="form-control pe-5" placeholder="不修改請留白" />
                    <label class="text-danger">強制重設密碼 (若不修改請留白)</label>
                    <button class="btn border-0 position-absolute end-0 top-50 translate-middle-y toggle-password" type="button" style="z-index: 10;">👁️</button>
                </div>
                <div class="form-text mt-2">密碼規則：需包含大寫、小寫英文、數字及特殊符號。</div>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">返回名單</a>
                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">儲存修改</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-password').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = this.parentElement.querySelector('input');
                if (input.type === 'password') {
                    input.type = 'text';
                    this.textContent = '🙈';
                } else {
                    input.type = 'password';
                    this.textContent = '👁️';
                }
            });
        });
    </script>
}