@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "會員詳細資料";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-lg border-0 rounded-4" style="background: rgba(255,255,255,0.85); backdrop-filter: blur(15px);">
        <div class="card-body p-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold m-0">會員詳細資訊</h3>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">返回名單</a>
            </div>

            <hr />

            <div class="row mb-5 mt-4">
                <div class="col-md-6">
                    <h5 class="text-muted mb-1">帳號信箱 (Email)</h5>
                    <p class="fs-4 fw-bold text-primary">@Model.Email</p>
                </div>
                <div class="col-md-6">
                    <h5 class="text-muted mb-1">系統識別碼 (ID)</h5>
                    <p class="fs-6 text-secondary font-monospace">@Model.Id</p>
                </div>
            </div>

            <h4 class="fw-bold mb-3 mt-5">該會員的日記紀錄 (@(((IEnumerable<dynamic>)ViewBag.UserRecords).Count()) 篇)</h4>
            <div class="table-responsive shadow-sm rounded-3">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">作品名稱</th>
                            <th class="px-4 py-3">狀態</th>
                            <th class="px-4 py-3">紀錄時間</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in ViewBag.UserRecords)
                        {
                            <tr>
                                <td class="px-4 py-3 fw-bold">@record.Media?.Title</td>
                                <td class="px-4 py-3">
                                    @if (record.IsPublic)
                                    {
                                        <span class="badge bg-success rounded-pill">公開</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-secondary rounded-pill">私人</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-muted">@record.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                        @if (((IEnumerable<dynamic>)ViewBag.UserRecords).Count() == 0)
                        {
                            <tr><td colspan="3" class="text-center py-4 text-muted">這位會員還沒寫過任何日記喔！</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>