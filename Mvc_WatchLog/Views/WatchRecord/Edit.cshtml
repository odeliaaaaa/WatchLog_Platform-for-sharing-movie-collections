@model Mvc_WatchLog.Models.WatchRecord

@{
    ViewData["Title"] = "編輯日記";
}

<div class="container d-flex justify-content-center align-items-center mt-5 mb-5" style="min-height: 70vh;">
    <div class="diary-card p-5 w-100 shadow-lg" style="max-width: 600px;">

        <div class="text-center mb-4">
            <h2 class="hero-subtitle mb-2" style="font-size: 2rem;">✏️ 續寫妳的觀影時光</h2>
            <p class="text-muted small">追劇進度更新了？隨時紀錄最新的想法吧！</p>
        </div>

        <form asp-action="Edit" method="post" id="diaryForm">
            <input type="hidden" asp-for="RecordId" />
            <input type="hidden" asp-for="MediaId" />

            <div class="form-group mb-4">
                <label class="fw-bold mb-2">🎬 正在編輯的作品</label>
                <input type="text" class="form-control form-control-lg rounded-pill px-4 text-muted" value="@Model.Media?.Title" readonly style="background-color: rgba(255, 255, 255, 0.3);" />
                <small class="text-muted ms-3 mt-1 d-block" style="font-size: 0.8rem;">劇名無法修改，若選錯作品請刪除後重新新增喔！</small>
            </div>

            <div class="form-group mb-4 text-center">
                <label class="fw-bold mb-2 d-block">⭐ 最新的評價是幾分呢？</label>
                <input type="hidden" asp-for="Rating" id="ratingValue" />
                <div class="star-rating" id="starContainer">
                    <span class="star" data-val="1">★</span>
                    <span class="star" data-val="2">★</span>
                    <span class="star" data-val="3">★</span>
                    <span class="star" data-val="4">★</span>
                    <span class="star" data-val="5">★</span>
                </div>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Review" class="fw-bold mb-2">📝 妳的最新想法</label>
                <textarea asp-for="Review" class="form-control rounded-4 p-3" rows="5" placeholder="隨意碎碎念吧..."></textarea>
                <span asp-validation-for="Review" class="text-danger"></span>
            </div>

            <div class="form-group mb-4 d-flex align-items-center justify-content-between p-3 rounded-pill" style="background: rgba(128,128,128,0.1);">
                <div>
                    <label class="fw-bold mb-0">公開這篇日記</label>
                    <small class="d-block text-muted" style="font-size: 0.8rem;">關閉後，只有妳自己能在首頁看到它</small>
                </div>
                <div class="form-check form-switch fs-4">
                    <input class="form-check-input" type="checkbox" asp-for="IsPublic" role="switch">
                </div>
            </div>
            <div class="form-group mb-4 d-flex align-items-center justify-content-between p-3 rounded-pill" style="background: rgba(128,128,128,0.1);">
                <div>
                    <label class="fw-bold mb-0">顯示官方海報</label>
                    <small class="d-block text-muted" style="font-size: 0.8rem;">關閉後，這篇日記將以純文字風格呈現</small>
                </div>
                <div class="form-check form-switch fs-4">
                    <input class="form-check-input" type="checkbox" asp-for="ShowPoster" role="switch">
                </div>
            </div>
            <div class="form-group mb-4 d-flex align-items-center justify-content-between p-3 rounded-pill" style="background: rgba(255, 118, 117, 0.1);">
                <div>
                    <label class="fw-bold mb-0 text-danger">包含劇透 (防雷區)</label>
                    <small class="d-block text-muted" style="font-size: 0.8rem;">開啟後，首頁的評論會被模糊處理，直到點擊才顯示</small>
                </div>
                <div class="form-check form-switch fs-4">
                    <input class="form-check-input" type="checkbox" asp-for="HasSpoiler" role="switch">
                </div>
            </div>
            <div class="text-center mt-5">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold w-100">更新這份記憶 ✨</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <style>
        .diary-card {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(15px);
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            transition: all 0.4s ease;
        }

        [data-theme="dark"] .diary-card {
            background: rgba(10, 15, 25, 0.7);
            border: 1px solid rgba(0, 255, 204, 0.2);
            box-shadow: 0 0 20px rgba(0, 255, 204, 0.1);
        }

        .star-rating .star {
            font-size: 2.5rem;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s ease, transform 0.2s ease;
            margin: 0 5px;
        }

            .star-rating .star:hover {
                transform: scale(1.2);
            }

            .star-rating .star.active {
                color: #ffd700;
                text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
            }

        [data-theme="dark"] .star-rating .star.active {
            color: #00ffcc;
            text-shadow: 0 0 15px rgba(0, 255, 204, 0.8);
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stars = document.querySelectorAll(".star");
            const ratingInput = document.getElementById("ratingValue");
            const currentRating = parseInt(ratingInput.value) || 0;

            // 網頁載入時，先點亮原本存好的星星數
            stars.forEach(s => {
                if (parseInt(s.getAttribute("data-val")) <= currentRating) {
                    s.classList.add("active");
                }
            });

            // 點擊打分邏輯
            stars.forEach(star => {
                star.addEventListener("click", function () {
                    const value = parseInt(this.getAttribute("data-val"));
                    ratingInput.value = value;
                    stars.forEach(s => {
                        if (parseInt(s.getAttribute("data-val")) <= value) {
                            s.classList.add("active");
                        } else {
                            s.classList.remove("active");
                        }
                    });
                });
            });
        });
    </script>
}