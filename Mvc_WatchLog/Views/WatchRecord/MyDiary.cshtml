@model IEnumerable<Mvc_WatchLog.Models.WatchRecord>

@{
    ViewData["Title"] = "我的日記";
}

<div class="text-center mt-5 mb-5">
    <h1 class="hero-title display-4 mb-3">📖 我的專屬放映室</h1>
    <p class="hero-subtitle lead mt-3">這裡收藏了你所有的觀影記憶，包含那些沒有說出口的秘密。</p>
</div>

<div class="container mb-5">
    @if (Model != null && Model.Any())
    {
        <div class="waterfall-container">
            @foreach (var item in Model)
            {
                <div class="review-card">
                    @if (item.ShowPoster && !string.IsNullOrEmpty(item.Media?.PosterUrl))
                    {
                        <img src="@item.Media.PosterUrl" class="w-100" alt="@item.Media.Title" loading="lazy">
                    }
                    else if (item.ShowPoster)
                    {
                        <div class="w-100 d-flex flex-column justify-content-center align-items-center text-muted" style="height: 250px; background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                            <span style="font-size: 3rem; opacity: 0.5;">🎞️</span>
                            <small class="fw-bold mt-2" style="opacity: 0.7;">資料庫暫無官方劇照 🥺</small>
                        </div>
                    }
                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h5 class="fw-bold mb-0">@item.Media?.Title</h5>
                            @if (item.IsPublic)
                            {
                                <span class="badge rounded-pill bg-primary" style="opacity: 0.8;">🌍 公開</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary" style="opacity: 0.8;">🔒 私人</span>
                            }
                        </div>

                        <div class="text-warning mt-2 mb-2" style="font-size: 14px;">
                            @for (int i = 0; i < (item.Rating ?? 0); i++)
                            {
                                <span>⭐</span>
                            }
                        </div>

                        <p class="card-text small mb-0 mt-2" style="color: var(--text-color); opacity: 0.9;">@item.Review</p>

                        <div class="mt-3 border-top pt-2 d-flex justify-content-end align-items-center" style="border-color: rgba(128,128,128,0.1) !important;">
                            <a asp-action="Edit" asp-route-id="@item.RecordId" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-2">✏️ 編輯</a>

                            <form asp-action="Delete" asp-route-id="@item.RecordId" method="post" class="delete-form mb-0">
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 delete-btn">🗑️ 刪除</button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column justify-content-center align-items-center" style="min-height: 20vh;">
            <p class="text-muted mb-4" style="font-size: 1.2rem; letter-spacing: 2px;">
                你的放映室目前空空如也 🍿
            </p>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2">寫下第一篇日記</a>
        </div>
    }
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 抓出畫面上所有的「刪除」按鈕
            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const form = this.closest('.delete-form');

                    // 彈出絕美防手滑確認視窗
                    Swal.fire({
                        title: '確定要刪除嗎？',
                        text: "這段觀影記憶刪除後就找不回來囉！",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#ff7675', // 柔和的紅色
                        cancelButtonColor: '#74b9ff', // 柔和的藍色
                        confirmButtonText: '對，刪掉它！',
                        cancelButtonText: '取消',
                        customClass: { popup: 'rounded-4' }
                    }).then((result) => {
                        // 如果他真的按下確認，才把表單送出給後台
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    })
                });
            });
        });
    </script>
}