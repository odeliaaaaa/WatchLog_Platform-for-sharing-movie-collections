@model IEnumerable<Mvc_WatchLog.Models.WatchRecord>
@{
    ViewData["Title"] = "我的收藏";
}

<div class="text-center mt-5 mb-5">
    <h1 class="hero-title display-4 mb-3">💖 我的收藏片單</h1>
    <p class="hero-subtitle lead mt-3">那些讓你心動的影評與秘密，都保存在這裡了。</p>
</div>

<div class="container mb-5">
    @if (Model != null && Model.Any())
    {
        <div class="row" data-masonry='{"percentPosition": true }'>
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-lg-4 mb-4 fav-card-wrapper">
                    <div class="card shadow-sm border-0 h-100 review-card" style="border-radius: 15px; overflow: hidden;">

                        @if (item.ShowPoster && !string.IsNullOrEmpty(item.Media?.PosterUrl))
                        {
                            <img src="@item.Media.PosterUrl" class="card-img-top" alt="@item.Media.Title" loading="lazy" style="max-height: 350px; object-fit: cover; object-position: top;">
                        }
                        else if (item.ShowPoster)
                        {
                            <div class="w-100 d-flex flex-column justify-content-center align-items-center text-muted" style="height: 250px; background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);">
                                <span style="font-size: 3rem; opacity: 0.5;">🎞️</span>
                                <small class="fw-bold mt-2" style="opacity: 0.7;">暫無官方海報 🥺</small>
                            </div>
                        }

                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title fw-bold text-dark mb-0" style="font-size: 1.3rem;">@item.Media?.Title</h5>
                            </div>

                            @if (item.HasSpoiler)
                            {
                                <div class="spoiler-container position-relative rounded p-3 mb-4" style="background: rgba(0,0,0,0.03); cursor: pointer;" onclick="this.classList.toggle('revealed')">
                                    <div class="spoiler-content" style="filter: blur(6px); transition: filter 0.4s ease;">
                                        <p class="card-text text-dark fw-medium mb-0" style="line-height: 1.7; font-size: 1.05rem;">
                                            @item.Review
                                        </p>
                                    </div>
                                    <div class="spoiler-overlay position-absolute top-50 start-50 translate-middle text-center w-100">
                                        <span class="badge rounded-pill bg-danger px-3 py-2 shadow-sm" style="font-size: 0.9rem;">
                                            ⚠️ 包含劇透，點擊查看
                                        </span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="card-text text-dark fw-medium mb-4" style="line-height: 1.7; font-size: 1.05rem;">
                                    @item.Review
                                </p>
                            }

                            <div class="mt-3 border-top pt-3 d-flex justify-content-between align-items-center" style="border-color: rgba(128,128,128,0.1) !important;">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-light text-dark border me-2">👤 @item.User?.Email?.Split('@')[0]</span>
                                </div>

                                <button class="btn btn-sm border-0 like-btn p-0 d-flex align-items-center ms-2" data-id="@item.RecordId" style="transition: transform 0.2s;">
                                    <span class="heart-icon fs-5 me-1">❤️</span>
                                    <span class="like-count fw-bold text-muted" style="font-size: 0.9rem;">
                                        @(item.Favorites?.Count ?? 0)
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column justify-content-center align-items-center" style="min-height: 30vh;">
            <span style="font-size: 4rem; opacity: 0.8; margin-bottom: 1rem;">🫙</span>
            <h4 class="fw-bold text-muted mb-3">你的收藏罐還是空的喔！</h4>
            <p class="text-muted mb-4">去首頁逛逛，把喜歡的影評通通裝進來吧 ✨</p>
            <a href="/Home/Index" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-bold">去首頁探索</a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js" integrity="sha384-GNFwBvfVxBkLMJpYMOABq3c+d3KnQxudP/mGPkzpZSTYykLBNsZEnG2D9G/X/+7D" crossorigin="anonymous" async></script>

    <style>
        .spoiler-container.revealed .spoiler-content {
            filter: blur(0) !important;
        }

        .spoiler-container.revealed .spoiler-overlay {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // 🌟 AJAX 取消收藏與動畫魔法
            document.querySelectorAll('.like-btn').forEach(btn => {

                // 滑鼠移上去的微動畫
                btn.addEventListener('mouseenter', () => btn.style.transform = 'scale(1.1)');
                btn.addEventListener('mouseleave', () => btn.style.transform = 'scale(1)');

                btn.addEventListener('click', async function () {
                    const recordId = this.dataset.id;
                    const icon = this.querySelector('.heart-icon');
                    const countSpan = this.querySelector('.like-count');

                    // 抓到這顆愛心所屬的整張卡片外層 (用來做消失動畫)
                    const cardWrapper = this.closest('.fav-card-wrapper');

                    try {
                        const formData = new FormData();
                        formData.append('recordId', recordId);

                        // 呼叫首頁寫好的同一個 API
                        const response = await fetch('/Home/ToggleLike', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await response.json();

                        if (data.success) {
                            if (!data.isLiked) {
                                // 💔 確定取消收藏了！
                                icon.textContent = '🤍';
                                countSpan.textContent = data.count;

                                // 加入漸隱縮小的過渡動畫
                                cardWrapper.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                                cardWrapper.style.opacity = '0';
                                cardWrapper.style.transform = 'scale(0.8)';

                                // 等動畫跑完 (0.4秒) 後，把卡片從畫面上刪除
                                setTimeout(() => {
                                    cardWrapper.remove();

                                    // 🌟 最神奇的一步：命令 Masonry 瀑布流重新排版，填補空位！
                                    const container = document.querySelector('.row[data-masonry]');
                                    if(container) {
                                        var msnry = Masonry.data(container);
                                        if(msnry) msnry.layout();
                                    }

                                    // 如果全刪光了，可以考慮重新整理頁面顯示「空罐子」提示
                                    if(document.querySelectorAll('.fav-card-wrapper').length === 0) {
                                        window.location.reload();
                                    }
                                }, 400);

                            } else {
                                // 如果手速太快又點回來
                                icon.textContent = '❤️';
                                countSpan.textContent = data.count;
                            }
                        }
                    } catch (error) {
                        console.error('取消收藏時發生錯誤:', error);
                    }
                });
            });

        });
    </script>
}