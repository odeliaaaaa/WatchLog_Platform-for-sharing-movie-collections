@page
@model PersonalDataModel
@{
    ViewData["Title"] = "帳號資料設定";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>您的帳戶包含您提供給本系統的個人資料。此頁面允許您下載或刪除這些資料。</p>
        <p>
            <strong class="text-danger">注意：刪除這些資料將永久移除您的帳戶，且操作無法復原。</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post" class="form-group mb-3">
            <button class="btn btn-primary" type="submit">📥 下載個人資料</button>
        </form>
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">🗑️ 刪除帳戶</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}