@page
@model SetPasswordModel
@{
    ViewData["Title"] = "設定密碼";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>設定您的密碼</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<p class="text-info">
    您尚未使用本地帳號/密碼登入此網站。請設定一組密碼，以便日後不依賴外部登入也能直接登入。
</p>
<div class="row">
    <div class="col-md-6">
        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.NewPassword" class="form-control pe-5" autocomplete="new-password" placeholder="請輸入新密碼" />
                <label asp-for="Input.NewPassword" class="form-label">新密碼</label>
                <button class="btn border-0 position-absolute end-0 top-50 translate-middle-y toggle-password" type="button" style="z-index: 10;">👁️</button>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.ConfirmPassword" class="form-control pe-5" autocomplete="new-password" placeholder="請再次確認新密碼" />
                <label asp-for="Input.ConfirmPassword" class="form-label">確認密碼</label>
                <button class="btn border-0 position-absolute end-0 top-50 translate-middle-y toggle-password" type="button" style="z-index: 10;">👁️</button>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">確認設定密碼</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('.toggle-password').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = this.parentElement.querySelector('input');
                if (input.type === 'password') {
                    input.type = 'text';
                    this.textContent = '🙈';
                } else {
                    input.type = 'password';
                    this.textContent = '👁️';
                }
            });
        });
    </script>
}